<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Inject product_creation_source='bom' into the product_tmpl_id
        field context on Manufacturing Bill of Materials form.
        Correct view ID in Odoo 18: mrp.mrp_bom_form_view
    -->
    <record id="view_mrp_bom_form_product_control" model="ir.ui.view">
        <field name="name">mrp.bom.form.product.creation.control</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">

            <!-- BOM header: the product this BOM produces -->
            <xpath expr="//field[@name='product_tmpl_id']" position="attributes">
                <attribute name="context">{'product_creation_source': 'bom', 'company_id': company_id, 'default_is_storable': True}</attribute>
            </xpath>

            <!-- Components tab: product_id on each BOM line -->
            <xpath expr="//field[@name='bom_line_ids']//field[@name='product_id']" position="attributes">
                <attribute name="context">{'product_creation_source': 'bom', 'default_is_storable': True}</attribute>
            </xpath>

            <!-- By-products tab: product_id on each by-product line -->
            <xpath expr="//field[@name='byproduct_ids']//field[@name='product_id']" position="attributes">
                <attribute name="context">{'product_creation_source': 'bom', 'default_is_storable': True}</attribute>
            </xpath>

        </field>
    </record>

    <!--
        Inject product_creation_source='bom' into product fields on the
        Manufacturing Order (mrp.production) form.
        Covers Components tab (move_raw_ids) and By-products tab (move_byproduct_ids).
    -->
    <record id="view_mrp_production_form_product_control" model="ir.ui.view">
        <field name="name">mrp.production.form.product.creation.control</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <!-- Components tab: product_id on each move line -->
            <xpath expr="//field[@name='move_raw_ids']//field[@name='product_id']" position="attributes">
                <attribute name="context">{'product_creation_source': 'bom', 'default_is_storable': True}</attribute>
            </xpath>

            <!-- By-products tab: product_id on each by-product line -->
            <xpath expr="//field[@name='move_byproduct_ids']//field[@name='product_id']" position="attributes">
                <attribute name="context">{'product_creation_source': 'bom', 'default_is_storable': True}</attribute>
            </xpath>

        </field>
    </record>

</odoo>
