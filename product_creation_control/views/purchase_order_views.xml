<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Inject product_creation_source='purchase_line' into the product_id
        field context on Purchase Order lines.
        Correct view ID in Odoo 18: purchase.purchase_order_form
    -->
    <record id="view_purchase_order_form_product_control" model="ir.ui.view">
        <field name="name">purchase.order.form.product.creation.control</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//field[@name='product_id']"
                   position="attributes">
                <attribute name="context">{'product_creation_source': 'purchase_line', 'partner_id': parent.partner_id, 'company_id': parent.company_id}</attribute>
            </xpath>
        </field>
    </record>

</odoo>
